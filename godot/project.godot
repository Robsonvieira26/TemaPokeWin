; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format allows others to know about the project.

config_version=5

[application]

config/name="TemaPokeWin"
config/description="Desktop pet simulation — Pokémon autônomo num mundo 2D"
config/version="0.1.0"
run/main_scene="res://scenes/World.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/tamapoke-256.png"

[autoload]

PetStats="*res://scripts/pet_stats.gd"
AppWindow="*res://scripts/app_window.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=480
window/size/resizable=false
window/per_pixel_transparency/allowed=true
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
